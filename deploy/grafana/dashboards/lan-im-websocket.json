      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "im_hub_task_pool_running{node_id=~\"$node\"}", "legendFormat": "运行中 {{node_id}}", "refId": "A"},
        {"expr": "im_hub_task_pool_waiting{node_id=~\"$node\"}", "legendFormat": "等待中 {{node_id}}", "refId": "B"},
        {"expr": "im_hub_task_pool_capacity{node_id=~\"$node\"}", "legendFormat": "容量 {{node_id}}", "refId": "C"}
      ],
      "title": "Gateway 独立 TaskPool",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 29},
      "id": 12,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(im_ws_connection_duration_seconds_bucket{node_id=~\"$node\"}[5m])))", "legendFormat": "P50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(im_ws_connection_duration_seconds_bucket{node_id=~\"$node\"}[5m])))", "legendFormat": "P95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(im_ws_connection_duration_seconds_bucket{node_id=~\"$node\"}[5m])))", "legendFormat": "P99", "refId": "C"}
      ],
      "title": "连接存活时长",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 29},
      "id": 13,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "histogram_quantile(0.95, sum by (le, operation) (rate(im_redis_latency_seconds_bucket[5m])))", "legendFormat": "{{operation}} P95", "refId": "A"},
        {"expr": "sum(rate(im_redis_errors_total[1m]))", "legendFormat": "Redis 错误/s", "refId": "B"}
      ],
      "title": "Redis 在线状态写入与错误",
      "type": "timeseries"
    }
