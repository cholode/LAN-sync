  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 0, "y": 0},
      "id": 1,
      "options": {"colorMode": "value", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "textMode": "auto"},
      "targets": [{"expr": "sum(im_ws_connections_active{node_id=~\"$node\"})", "refId": "A"}],
      "title": "当前 WebSocket 连接",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
      "fieldConfig": {"defaults": {"unit": "cps"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(rate(im_ws_connection_pipeline_total{node_id=~\"$node\",stage=\"ready_total\"}[1m]))", "refId": "A"}],
      "title": "建连请求 / 秒",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0},
      "id": 3,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "sum(rate(im_ws_connection_pipeline_total{node_id=~\"$node\",stage=\"ready_total\",result=~\"success|degraded\"}[1m])) / clamp_min(sum(rate(im_ws_connection_pipeline_total{node_id=~\"$node\",stage=\"ready_total\"}[1m])), 0.000001)", "refId": "A"}],
      "title": "建连可用率",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "max(im_ws_connection_stage_second_latency_milliseconds{node_id=~\"$node\",stage=\"ready_total\",quantile=\"0.95\"})", "refId": "A"}],
      "title": "全链路 P95（最近秒）",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
