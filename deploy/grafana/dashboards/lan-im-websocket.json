      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "max(im_ws_connection_stage_second_latency_milliseconds{node_id=~\"$node\",stage=\"auth\",quantile=\"0.50\"})", "legendFormat": "鉴权 P50", "refId": "A"},
        {"expr": "max(im_ws_connection_stage_second_latency_milliseconds{node_id=~\"$node\",stage=\"auth\",quantile=\"0.95\"})", "legendFormat": "鉴权 P95", "refId": "B"},
        {"expr": "max(im_ws_connection_stage_second_latency_milliseconds{node_id=~\"$node\",stage=\"auth\",quantile=\"0.99\"})", "legendFormat": "鉴权 P99", "refId": "C"}
      ],
      "title": "鉴权延迟（按秒 P50 / P95 / P99）",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 5},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "max(im_ws_connection_stage_second_latency_milliseconds{node_id=~\"$node\",stage=\"ready_total\",quantile=\"0.50\"})", "legendFormat": "全链路 P50", "refId": "A"},
        {"expr": "max(im_ws_connection_stage_second_latency_milliseconds{node_id=~\"$node\",stage=\"ready_total\",quantile=\"0.95\"})", "legendFormat": "全链路 P95", "refId": "B"},
        {"expr": "max(im_ws_connection_stage_second_latency_milliseconds{node_id=~\"$node\",stage=\"ready_total\",quantile=\"0.99\"})", "legendFormat": "全链路 P99", "refId": "C"}
      ],
      "title": "可传输延迟（按秒 P50 / P95 / P99）",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 13},
      "id": 7,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "max by (stage) (im_ws_connection_stage_second_latency_milliseconds{node_id=~\"$node\",quantile=\"0.95\"})", "legendFormat": "{{stage}}", "refId": "A"}],
      "title": "各建连阶段 P95（最近秒）",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 13},
      "id": 8,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [{"expr": "sum by (stage, result) (rate(im_ws_connection_pipeline_total{node_id=~\"$node\"}[1m]))", "legendFormat": "{{stage}} / {{result}}", "refId": "A"}],
      "title": "建连阶段结果 / 秒",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 21},
      "id": 9,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum(rate(im_ws_read_messages_total{node_id=~\"$node\"}[1m]))", "legendFormat": "读取消息/s", "refId": "A"},
        {"expr": "sum(rate(im_ws_write_messages_total{node_id=~\"$node\"}[1m]))", "legendFormat": "写出消息/s", "refId": "B"},
        {"expr": "sum(rate(im_hub_dispatched_messages_total{node_id=~\"$node\"}[1m]))", "legendFormat": "Hub 分发/s", "refId": "C"}
      ],
      "title": "消息吞吐",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 21},
      "id": 10,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "sum by (error_type) (rate(im_ws_read_errors_total{node_id=~\"$node\"}[1m]))", "legendFormat": "读错误 {{error_type}}", "refId": "A"},
        {"expr": "sum by (error_type) (rate(im_ws_write_errors_total{node_id=~\"$node\"}[1m]))", "legendFormat": "写错误 {{error_type}}", "refId": "B"},
        {"expr": "sum by (reason) (rate(im_hub_queue_drops_total{node_id=~\"$node\"}[1m]))", "legendFormat": "丢弃 {{reason}}", "refId": "C"}
      ],
      "title": "WebSocket 错误与丢弃",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 21},
