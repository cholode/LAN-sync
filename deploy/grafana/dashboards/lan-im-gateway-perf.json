      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [{"expr": "max(k6_unique_deliveries_total{testid=~\"$testid\"})", "refId": "A"}],
      "title": "唯一触达",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "red", "value": 1}]}}, "overrides": []},
      "gridPos": {"h": 5, "w": 6, "x": 18, "y": 0},
      "id": 4,
      "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}},
      "targets": [
        {"expr": "max(k6_duplicate_deliveries_total{testid=~\"$testid\"})", "legendFormat": "重复", "refId": "A"},
        {"expr": "max(k6_socket_errors_total{testid=~\"$testid\"})", "legendFormat": "错误", "refId": "B"}
      ],
      "title": "重复投递 / Socket 错误",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []},
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 5},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}, "tooltip": {"mode": "multi", "sort": "desc"}},
      "targets": [
        {"expr": "max(k6_delivery_latency_ms_p50{testid=~\"$testid\"})", "legendFormat": "P50", "refId": "A"},
        {"expr": "max(k6_delivery_latency_ms_p95{testid=~\"$testid\"})", "legendFormat": "P95", "refId": "B"},
        {"expr": "max(k6_delivery_latency_ms_p99{testid=~\"$testid\"})", "legendFormat": "P99", "refId": "C"}
      ],
      "title": "k6 端到端投递延迟",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "lan-im-prometheus"},
