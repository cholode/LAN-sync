# 此文件由 nginx 官方 entrypoint 在容器启动时通过 envsubst 渲染。
# NGINX_ENVSUBST_FILTER 会限制只替换部署变量，保留 $host、$uri 等 Nginx 变量。
upstream backend_api {
    zone backend_api 64k;
    server ${BACKEND_HOST}:${BACKEND_PORT} resolve max_fails=3 fail_timeout=10s;
    keepalive 32;
}

upstream admin_api {
    zone admin_api 64k;
    server ${ADMIN_HOST}:${ADMIN_PORT} resolve max_fails=3 fail_timeout=10s;
    keepalive 16;
}

upstream room_api {
    zone room_api 64k;
    server ${ROOM_HOST}:${ROOM_PORT} resolve max_fails=3 fail_timeout=10s;
    keepalive 16;
}

# Docker 内置 DNS 会在服务容器重建、更换 IP 后刷新上游地址。
resolver 127.0.0.11 valid=5s ipv6=off;

server {
    listen 80 default_server backlog=65535;
    server_name ${NGINX_SERVER_NAME};

    location / {
        root /usr/share/nginx/html;
        index index.html public.html;
        try_files $uri $uri/ /index.html;
    }

    location /api/v1/ws {
        proxy_pass http://backend_api;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location ^~ /api/v1/admin/ {
        proxy_pass http://admin_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 群聊生命周期和成员管理由独立 Room Service 处理；消息接口仍由 Backend 处理。
    location = /api/v1/rooms {
        proxy_pass http://room_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /api/v1/my_rooms {
        proxy_pass http://room_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location ~ ^/api/v1/rooms/[0-9]+/(join|members(/[0-9]+)?|disband)$ {
        proxy_pass http://room_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/ {
        proxy_pass http://backend_api;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
