# ============================
# MySQL
# ============================
DB_PASSWORD=your_db_password
DB_NAME=lan_im
DB_DSN=root:${DB_PASSWORD}@tcp(127.0.0.1:3306)/${DB_NAME}?charset=utf8mb4&parseTime=True&loc=Local

# ============================
# Redis
# ============================
REDIS_ADDR=127.0.0.1:6379


# ============================
# MongoDB - message storage
# ============================
MESSAGE_STORE=mysql
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=lan_im

# ============================
# Elasticsearch - message search
# ============================
ES_ENABLED=true
ES_ADDR=http://127.0.0.1:9200
ES_INDEX_MESSAGES=lan-im-messages


# ============================
# Kafka
# ============================
KAFKA_ADDR=127.0.0.1:9092

# ============================
# HTTP 服务端口
# ============================
SERVER_PORT=8080

# ============================
# JWT
# ============================
JWT_SECRET=your-jwt-secret-key


# ============================
# LLM 对话模型 - DeepSeek
# ============================
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-chat

# ============================
# Embedding 嵌入模型 - 豆包 (火山引擎)
# ============================
EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBED_API_KEY=your_embedding_api_key
EMBED_MODEL=doubao-embedding-vision-251215

# ============================
# Qdrant 向量数据库
# ============================
QDRANT_HOST=localhost

# ============================
# 文件存储
# ============================
# Object Storage
# ============================
STORAGE_BACKEND=minio            # minio (default) or oss
MINIO_ENDPOINT=localhost:9000
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lan-im-files
# OSS settings (STORAGE_BACKEND=oss)
# OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OSS_ACCESS_KEY=your_access_key
# OSS_SECRET_KEY=your_secret_key
# OSS_BUCKET=lan-im-files
# ============================
# 话题分块间隔 (默认 5m)
# ============================
# TOPIC_CHUNK_INTERVAL=5m

# ============================
# 日志配置
# ============================
# LAN_IM_ENV=production      # 留空=开发(文本), production=JSON
# LAN_IM_LOG_FILE=./logs/im-server.log  # 留空=仅控制台
# LAN_IM_LOG_LEVEL=debug     # debug/info/warn/error

# ============================
# Agent gRPC ??
# ============================
AGENT_GRPC_ADDR=127.0.0.1:50051
AGENT_GRPC_PORT=50051

# ============================
# 监控指标与节点标识
# ============================
METRICS_ENABLED=true
METRICS_ADDR=0.0.0.0:6060
METRICS_PATH=/metrics
# 集群部署时每个节点设置不同 NODE_ID
NODE_ID=lan-im-node-1
