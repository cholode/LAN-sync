# ============================
# Docker 国内镜像代理
# ============================
DOCKER_HUB_MIRROR=dockerproxy.net
ELASTIC_IMAGE=dockerproxy.net/library/elasticsearch:8.17.0

# ============================
# MySQL
# ============================
DB_PASSWORD=your_db_password
DB_NAME=lan_im
# 仅在宿主机直接运行 Go 服务时使用；Docker Compose 会使用 db:3306 重新构造该值。
DB_DSN=root:${DB_PASSWORD}@tcp(127.0.0.1:3306)/${DB_NAME}?charset=utf8mb4&parseTime=True&loc=Local

# ============================
# Redis
# ============================
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
# 0 表示使用客户端默认值；超时支持 500ms、3s 等 Go duration 格式。
REDIS_POOL_SIZE=0
REDIS_MIN_IDLE_CONNS=0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s


# ============================
# MongoDB - message storage
# ============================
# 使用 MongoDB 保存聊天消息；用户、房间等业务数据仍保存在 MySQL。
MESSAGE_STORE=mongo
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=lan_im

# ============================
# Elasticsearch - message search
# ============================
ES_ENABLED=true
ES_ADDR=http://127.0.0.1:9200
ES_INDEX_MESSAGES=lan-im-messages


# ============================
# Kafka
# ============================
# 多 Broker 使用逗号分隔。KAFKA_ADDR 仍兼容，但建议统一使用 KAFKA_BROKERS。
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC=im_chat_messages
KAFKA_ARCHIVER_GROUP=im_archiver_group
# 保持现有低延迟行为；设为 false 可让生产调用同步等待 Kafka 确认。
KAFKA_PRODUCER_ASYNC=true

# ============================
# HTTP 服务端口
# ============================
SERVER_PORT=8080

# ============================
# 管理端服务
# ============================
# 仅未来重新拆分独立管理服务时开启；合并部署保持 false。
ADMIN_CONTROL_GRPC_ENABLED=true
ADMIN_HTTP_PORT=8081
ADMIN_CONTROL_GRPC_ADDR=127.0.0.1:50053
ADMIN_CONTROL_TOKEN=change-me-admin-token
NGINX_ADMIN_HOST=admin-service
NGINX_ADMIN_PORT=8081

# ============================
# JWT
# ============================
JWT_SECRET=your-jwt-secret-key


# ============================
# LLM 对话模型 - DeepSeek
# ============================
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-chat

# ============================
# Embedding 嵌入模型 - 豆包 (火山引擎)
# ============================
EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBED_API_KEY=your_embedding_api_key
EMBED_MODEL=doubao-embedding-vision-251215

# ============================
# Qdrant 向量数据库
# ============================
QDRANT_HOST=localhost

# ============================
# 文件存储
# ============================
# Object Storage
# ============================
# 可选值：minio、oss
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
# 浏览器访问地址（代码当前要求 host:port，不带协议）。部署到服务器时改为服务器 IP 或域名。
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lan-im-files
# OSS settings (STORAGE_BACKEND=oss)
# OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OSS_ACCESS_KEY=your_access_key
# OSS_SECRET_KEY=your_secret_key
# OSS_BUCKET=lan-im-files
# ============================
# 话题分块间隔 (默认 5m)
# ============================
TOPIC_CHUNK_INTERVAL=5m

# ============================
# 日志配置
# ============================
# LAN_IM_ENV=production      # 留空=开发(文本), production=JSON
# LAN_IM_LOG_FILE=./logs/im-server.log  # 留空=仅控制台
# LAN_IM_LOG_LEVEL=debug     # debug/info/warn/error

# ============================
# Python Agent 服务
# ============================
AGENT_HTTP_PORT=8000
AGENT_KAFKA_GROUP=agent_service

# ============================
# 监控指标与节点标识
# ============================
METRICS_ENABLED=true
METRICS_ADDR=0.0.0.0:6060
METRICS_PATH=/metrics

# Nginx 网关（容器内默认通过 Compose 服务名访问 backend）
NGINX_SERVER_NAME=_
NGINX_BACKEND_HOST=backend
NGINX_BACKEND_PORT=8080
# 集群部署时每个节点设置不同 NODE_ID
NODE_ID=lan-im-node-1

# ============================
# Prometheus / Grafana
# ============================
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
