# ============================
# MySQL
# ============================
DB_PASSWORD=your_db_password
DB_NAME=lan_im
DB_DSN=root:${DB_PASSWORD}@tcp(127.0.0.1:3306)/${DB_NAME}?charset=utf8mb4&parseTime=True&loc=Local

# ============================
# Redis
# ============================
REDIS_ADDR=127.0.0.1:6379

# ============================
# Kafka
# ============================
KAFKA_ADDR=127.0.0.1:9092

# ============================
# HTTP
# ============================
SERVER_PORT=8080

# ============================
# JWT
# ============================
JWT_SECRET=your-jwt-secret-key

# ============================
# LLM Chat - DeepSeek
# ============================
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_deepseek_api_key
LLM_MODEL=deepseek-chat

# ============================
# Embedding (Doubao/SiliconFlow)
# ============================
EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBED_API_KEY=your_embedding_api_key
EMBED_MODEL=doubao-embedding-vision-251215

# ============================
# Qdrant 向量数据库
# ============================
QDRANT_HOST=localhost

# ============================
# 日志配置
# ============================
# LAN_IM_ENV=production
# LAN_IM_LOG_FILE=./logs/im-server.log
# LAN_IM_LOG_LEVEL=debug