# 复制为 .env 后填写密码与 API Key；本文件只包含示例值。
# Compose 只向容器传入 docker-compose.yml 的 environment 中声明的变量。
# 标注“仅直接运行”的选项需导入对应进程环境；Go 服务不会自动读取 .env。
# 容器内数据库、Redis、Kafka 等地址由 Compose 设置为服务名。

# ============================
# Docker 镜像
# ============================
DOCKER_HUB_MIRROR=dockerproxy.net
ELASTIC_IMAGE=dockerproxy.net/library/elasticsearch:8.17.0
# 使用官方源时分别改为 docker.io 和 docker.io/library/elasticsearch:8.17.0。

# ============================
# MySQL
# ============================
DB_PASSWORD=your_db_password
DB_NAME=lan_im
# AI 数据库工具账号密码：仅字母、数字、点、下划线和短横线，至少 16 位。
AGENT_QUERY_DB_PASSWORD=replace_with_a_long_random_password
# 仅直接运行 Go 服务；Compose 使用 db:3306 重新构造该值。
DB_DSN=root:${DB_PASSWORD}@tcp(127.0.0.1:3306)/${DB_NAME}?charset=utf8mb4&parseTime=True&loc=UTC
# 仅直接运行 Python Agent：取消注释并填写相同密码。
# AGENT_DATABASE_URL=mysql+aiomysql://root:your_db_password@127.0.0.1:3306/lan_im?charset=utf8mb4
# AGENT_QUERY_DATABASE_URL=mysql+pymysql://agent_reader:replace_with_a_long_random_password@127.0.0.1:3306/lan_im?charset=utf8mb4
# 默认 Compose 分别通过 Agent 的回退逻辑和 environment 构造上述 URL，不读取这里的值。

# ============================
# Redis
# ============================
REDIS_ADDR=127.0.0.1:6379
# 默认 Compose 的 Redis 未启用密码；启用认证也需修改 Redis 服务启动配置。
REDIS_PASSWORD=
REDIS_DB=0
# PoolSize=0 使用客户端默认池大小，MinIdleConns=0 不要求保留空闲连接。
# 超时支持 500ms、3s 等 Go duration 格式；以下调优项目前仅透传给 Compose 的 backend。
REDIS_POOL_SIZE=0
REDIS_MIN_IDLE_CONNS=0
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# ============================
# 消息存储与搜索
# ============================
# 可选 mongo、mysql。本示例使用 MongoDB；用户、房间等业务数据仍保存在 MySQL。
# Gateway、Message API/Worker 和 Admin 必须使用相同的消息存储配置。
MESSAGE_STORE=mongo
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=lan_im
ES_ENABLED=true
ES_ADDR=http://127.0.0.1:9200
ES_INDEX_MESSAGES=lan-im-messages
# 仅直接运行 Message 服务：连接启用认证的 Elasticsearch 时配置。
# ES_USERNAME=elastic
# ES_PASSWORD=replace_with_elasticsearch_password

# ============================
# Kafka
# ============================
# 多 Broker 使用逗号分隔。KAFKA_ADDR 仅为 Go 的旧变量回退，建议统一使用 KAFKA_BROKERS。
# 宿主机直连时还需确保 Kafka 广播的 advertised.listeners 地址可达。
KAFKA_BROKERS=127.0.0.1:9092
KAFKA_TOPIC=im_chat_messages_sequenced_v1
KAFKA_INGRESS_TOPIC=im_chat_messages_ingress_v1
WS_HEARTBEAT_ENABLED=true
KAFKA_ARCHIVER_GROUP=im_archiver_group
# Gateway 有界批量生产：达到任一上限即写入；调用方仍等待所属批次获得 Kafka 确认。
KAFKA_PRODUCER_BATCH_MESSAGES=1000
KAFKA_PRODUCER_BATCH_BYTES=1048576
KAFKA_PRODUCER_BATCH_WAIT=5ms
KAFKA_PRODUCER_QUEUE_CAPACITY=20000
KAFKA_PRODUCER_WRITE_TIMEOUT=10s

# ============================
# Gateway（登录、WebSocket 与内部 gRPC）
# ============================
SERVER_PORT=8080
# 仅直接运行 Gateway；Compose 中使用代码默认值 0.0.0.0:50052。
# IM_GRPC_ADDR=0.0.0.0:50052
# 登录频率限制开关，Compose 已透传。压测可设 false，关闭 IP 和 IP+账号的次数限制。
# 密码验证、bcrypt 并发保护和登录超时继续生效；修改后需重新创建 Gateway 容器。
LOGIN_RATE_LIMIT_ENABLED=true
# 以下细项仅直接运行 Gateway；Compose 尚未透传。
# LOGIN_IP_LIMIT_PER_MINUTE=200
# LOGIN_IP_USERNAME_LIMIT_PER_MINUTE=5
# LOGIN_TIMEOUT_SECONDS=5
# bcrypt 并发默认 max(1, runtime.NumCPU()*2)，取消注释可指定固定值。
# LOGIN_BCRYPT_CONCURRENCY=32

# ============================
# Message 服务（API、Sequencer、Worker 三个进程）
# ============================
# 仅直接运行 API；Compose 和 Nginx 当前固定使用容器端口 8083。
# MESSAGE_SERVER_PORT=8083
# 直接运行 Worker / Sequencer 时，分别给各自进程设置 METRICS_ADDR：
# Worker：0.0.0.0:6061；Sequencer：0.0.0.0:6062，避免继承 Gateway 的 6060。
# Sequencer 编号状态保存在内存中；当前 Compose 只运行一个实例且不自动重启。

# ============================
# 房间服务
# ============================
ROOM_SERVER_PORT=8082
NGINX_ROOM_HOST=room-service

# ============================
# 管理端服务
# ============================
# 当前 Admin 已独立部署，Gateway 需要开启控制面供 Admin 调用。
ADMIN_CONTROL_GRPC_ENABLED=true
ADMIN_SERVER_PORT=8081
ADMIN_FRONTEND_PORT=5174
# 宿主机直接运行时的地址；Compose 为 Gateway 设置 0.0.0.0:50053，
# 为 Admin 设置连接地址 backend:50053。
ADMIN_CONTROL_GRPC_ADDR=127.0.0.1:50053
ADMIN_CONTROL_TOKEN=change-me-admin-token
NGINX_ADMIN_HOST=admin-service

# ============================
# JWT（所有校验令牌的服务使用同一密钥）
# ============================
JWT_SECRET=your-jwt-secret-key

# ============================
# Python Agent
# ============================
LLM_API_KEY=your_deepseek_api_key
EMBED_API_KEY=your_embedding_api_key
AGENT_HTTP_PORT=8000
AGENT_KAFKA_GROUP=agent_service
# 模型名称、API 地址、Qdrant、Agent Redis 和 IM gRPC 地址等在
# services/agent/runtime/config.yaml 中配置；默认 Compose 挂载此文件。
# 仅直接运行 Python Agent：可指定自定义配置文件；Compose 固定为 /app/config.yaml。
# AGENT_CONFIG_PATH=./services/agent/runtime/config.yaml
# 宿主机直接运行时，配置文件中的 qdrant、redis、backend 地址也需按实际环境修改。

# ============================
# 旧 Compose 兼容输入（当前业务代码不读取）
# ============================
# 保留这些值以满足现有 Compose 的变量引用；修改它们不会改变 Agent 配置。
# 模型配置请修改上面的 config.yaml；分块批次窗口对应 kafka.batch_window_seconds。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
EMBED_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBED_MODEL=doubao-embedding-vision-251215
TOPIC_CHUNK_INTERVAL=5m

# ============================
# 文件存储
# ============================
# 可选 minio、oss。
STORAGE_BACKEND=minio
MINIO_ENDPOINT=localhost:9000
# 浏览器访问地址（host:port，不带协议）；部署到服务器时改为服务器 IP 或域名。
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lan-im-files
# OSS（STORAGE_BACKEND=oss）：以下变量尚未透传给 Compose 的 Message/Admin，
# 使用 OSS 时需同时补充对应容器的 environment。
# OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
# OSS_ACCESS_KEY=your_access_key
# OSS_SECRET_KEY=your_secret_key
# OSS_BUCKET=lan-im-files

# ============================
# 日志（仅直接运行 Go 服务；默认 Compose 尚未透传）
# ============================
# LAN_IM_ENV=production      # 留空=开发(文本), production=JSON
# LAN_IM_LOG_FILE=./logs/im-server.log  # 留空=仅控制台
# LAN_IM_LOG_LEVEL=debug     # debug/info/warn/error/off

# ============================
# 监控指标、节点标识与 Hub
# ============================
# 以下三个值由 Compose 传给 Gateway；Worker/Sequencer 使用各自固定的指标端口。
METRICS_ENABLED=true
METRICS_ADDR=0.0.0.0:6060
METRICS_PATH=/metrics
# 集群部署时每个 Gateway 设置不同 NODE_ID；Compose 为 Message 各进程分别设置节点名。
NODE_ID=lan-im-node-1
# Hub 分片数：仅直接运行 Gateway，Compose 尚未透传。
# HUB_SHARD_COUNT=64
# 每个 Gateway 实例独占的大群扇出协程池。
# 代码默认 GOMAXPROCS*4，Compose 默认 64；每个任务最多处理 200 个本机连接。
HUB_FANOUT_WORKERS=64
HUB_FANOUT_THRESHOLD=100
HUB_FANOUT_BATCH_SIZE=200

# ============================
# Nginx 网关
# ============================
NGINX_SERVER_NAME=_
NGINX_BACKEND_HOST=backend
NGINX_BACKEND_PORT=8080
# Admin/Room 上游使用前面的服务端口；Message 上游固定为 message-service:8083。

# ============================
# Prometheus / Grafana
# ============================
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password
