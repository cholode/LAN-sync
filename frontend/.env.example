# 开发代理指向 Compose Nginx 统一入口，按路径转发房间、消息及 WebSocket 请求
VITE_DEV_BACKEND=http://127.0.0.1

# 开发环境管理后台地址（vite proxy）
VITE_DEV_ADMIN_BACKEND=http://127.0.0.1:8081

# 浏览器直接请求 API 时的前缀；同源部署保持 /api/v1
VITE_API_BASE=/api/v1

# WebSocket 鉴权方式：query / protocol
VITE_WS_AUTH_MODE=query

# 仅用于 UI 演示；生产环境务必 false
VITE_ADMIN_DEMO=false
